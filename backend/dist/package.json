{
  "name": "pos-solution-api",
  "version": "1.0.0",
  "description": "REST API for Sales Man Utility Flutter App",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run prepare:deploy",
    "build:exe": "pkg . --output dist/salesman-api.exe",
    "build:exe:here": "pkg . --output salesman-api.exe",
    "prepare:deploy": "node scripts/prepare-deploy.js",
    "package:windows": "node scripts/package-windows-portable.js",
    "prefetch:pkg": "node scripts/prefetch-pkg-base.js"
  },
  "engines": {
    "node": ">=18 <=22"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "runtime.js",
      "utils/**/*.js"
    ],
    "assets": [],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mssql": "^9.1.1",
    "resend": "^6.18.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0",
    "nodemon": "^3.1.14"
  }
}
